# Optional: pre-generated audio catalog (see src/lib/audioFiles.ts).
# Set both to enable the file-based sink, which plays sample files instead
# of the native device TTS whenever a file exists, falling back to native
# per chunk if a file is missing.
#
#   NEXT_PUBLIC_AUDIO_ROOT=https://pub-abc123.r2.dev/glory
#   NEXT_PUBLIC_AUDIO_VOICE=grace
#
# File URL contract (the generation pipeline must produce exactly these):
#   {NEXT_PUBLIC_AUDIO_ROOT}/v1/{NEXT_PUBLIC_AUDIO_VOICE}/{sha1(text)}.m4a
# where sha1(text) is the lowercase hex SHA-1 of the chunk text.